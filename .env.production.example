# PostgreSQL connection used only by the Next.js server and database scripts.
DATABASE_URL=postgresql://pos_app:replace-with-url-encoded-password@127.0.0.1:5432/pos_db
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Remote database resets are blocked unless this is explicitly changed to true.
ALLOW_REMOTE_DB_RESET=false

# Idempotent production administrator created by db:seed:production.
PRODUCTION_ADMIN_NAME=POS Administrator
PRODUCTION_ADMIN_USERNAME=admin
PRODUCTION_ADMIN_PASSWORD=replace-with-at-least-12-characters

# Public address seen by users. Keep DATABASE_URL private; never use NEXT_PUBLIC_ for it.
NEXTAUTH_URL=https://pos.panatradeprestasi.net
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32-output
